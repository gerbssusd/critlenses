{
  "name": "critical-lenses-slidev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md --base /",
    "export": "slidev export slides.md --output critical-lenses.pdf",
    "export:png": "slidev export slides.md --format png --with-clicks --output slides-png",
    "localize": "node scripts/localize-images.mjs"
  },
  "dependencies": {
    "@slidev/cli": "52.20.1",
    "@slidev/theme-seriph": "0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.55.0"
  }
}
